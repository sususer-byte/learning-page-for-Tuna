      "4. Sau khi hoàn thành xuất sắc các thử thách trong phòng máy, quay lại hệ thống để đánh dấu hoàn tất cột mốc và tiếp tục lộ trình."
    ],
    "required_milestone": "cybersecurity-m9"
  }
};

if (typeof window !== 'undefined') {
  window.pipelineData = pipelineData;
  window.courseData = courseData;
  window.examData = examData;
}
if (typeof module !== 'undefined' && module.exports) {
  module.exports = { pipelineData, courseData, examData };
}
