const courseData = {
  "web-dev": {
    "id": "web-dev",
    "title": "Phát Triển Web Toàn Diện",
    "subtitle": "Giáo trình chuẩn cho Phát Triển Web Toàn Diện",
    "intro": {
      "kicker": "Chương Trình Đào Tạo",
      "headline": "Phát Triển Web Toàn Diện",
      "pedagogyTitle": "Nguồn Tham Chiếu",
      "pedagogyItems": [
        {
          "name": "Official Docs",
          "desc": "Tài liệu chuẩn mực ngành."
        }
      ]
    },
    "lessons": [
      {
        "id": "web-dev_l1_1",
        "milestone_id": "web-dev-m1",
        "number": "Bài 1.1",
        "title": "Internet hoạt động thế nào (DNS, HTTP/HTTPS, mô hình Client–Server)",
        "objective": "Thấu suốt kiến trúc mạng Client-Server, quá trình phân giải DNS phân cấp, cơ chế TCP/TLS Handshake và giao thức HTTP/HTTPS.",
        "prerequisites": [
          "Kiến thức sử dụng máy tính cơ bản",
          "Biết mở trình duyệt web"
        ],
        "core_theory": {
          "explanation": "<b>Mô hình Client-Server:</b> Đây là kiến trúc xương sống của toàn bộ hệ sinh thái ứng dụng Web. Client (máy khách) thường là trình duyệt web của người dùng (Chrome, Firefox, Safari) hoặc một ứng dụng di động. Nhiệm vụ của Client là cung cấp giao diện hiển thị, tiếp nhận thao tác của người dùng và gửi các yêu cầu (Requests). Server (máy chủ) là những cỗ máy tính mạnh mẽ hoạt động 24/7, nằm tại các trung tâm dữ liệu lớn. Server lưu trữ mã nguồn, cơ sở dữ liệu và tài nguyên hệ thống. Khi nhận yêu cầu từ Client, Server sẽ xử lý logic nghiệp vụ và trả về kết quả (Responses). Sự phân tách này cho phép một Server có thể phục vụ hàng triệu Client mà không bắt người dùng phải tải về toàn bộ mã nguồn cơ sở dữ liệu khổng lồ.<br><br><b>Hệ thống phân giải tên miền (DNS - Domain Name System):</b> Con người rất giỏi ghi nhớ các chuỗi ký tự có nghĩa như roadmap.sh hay theodinproject.com, nhưng máy tính và các thiết bị định tuyến lại chỉ hiểu một chuỗi số vật lý gọi là địa chỉ IP (ví dụ: 192.168.1.1). DNS ra đời để đóng vai trò như cuốn danh bạ điện thoại khổng lồ của Internet. Khi bạn nhập URL vào trình duyệt, DNS sẽ phân giải chuỗi tên miền đó thành một địa chỉ IP chính xác của máy chủ đang lưu trữ hệ thống, giúp Client biết đường gửi dữ liệu tới đúng đích đến.<br><br><b>Giao thức HTTP và HTTPS:</b> HTTP (HyperText Transfer Protocol) là bộ quy tắc chuẩn quy định cách thức dữ liệu được định dạng và truyền tải giữa Client và Server. HTTP là giao thức phi trạng thái (stateless), tức là mỗi yêu cầu đều độc lập, không nhớ lịch sử của các yêu cầu trước. Tuy nhiên, HTTP truyền tải dữ liệu dưới dạng văn bản thô (plain text), khiến tin tặc dễ dàng nghe lén hoặc đánh cắp mật khẩu. Do đó, HTTPS (HTTP Secure) ra đời như một lớp khiên bọc thép. HTTPS mã hóa đường truyền bằng công nghệ SSL/TLS, biến mọi dữ liệu qua mạng thành chuỗi ký tự vô nghĩa đối với bất kỳ kẻ xâm nhập nào, đảm bảo tính toàn vẹn và bí mật.",
          "verified_runnable_code": "// [DEV ACADEMY] - Thực hành gửi HTTP GET Request & Phân tích Response Headers\nasync function inspectHttpCycle() {\n  console.log(\">> Bắt đầu chu trình Client-Server...\");\n  console.log(\">> Đang gửi HTTP GET Request tới máy chủ GitHub API: https://api.github.com\");\n\n  try {\n    // Trình duyệt thực hiện bắt tay DNS -> TCP Handshake -> TLS Handshake (HTTPS)\n    const response = await fetch(\"https://api.github.com\", {\n      method: \"GET\",\n      headers: {\n        \"Accept\": \"application/vnd.github.v3+json\"\n      }\n    });\n\n    console.log(\"\\n=== 1. KẾT QUẢ HTTP RESPONSE STATUS ===\");\n    console.log(`[+] Mã trạng thái (Status Code): ${response.status} ${response.statusText}`);\n    console.log(`[+] Đánh giá: ${response.ok ? 'Thành công (200 OK)' : 'Có lỗi phát sinh'}`);\n\n    console.log(\"\\n=== 2. CÁC TRƯỜNG HEADERS QUAN TRỌNG TỪ SERVER ===\");\n    console.log(`[+] Định dạng dữ liệu (Content-Type): ${response.headers.get(\"content-type\")}`);\n    console.log(`[+] Máy chủ định danh (Server): ${response.headers.get(\"server\") || \"GitHub.com\"}`);\n    console.log(`[+] Chính sách bảo mật (HSTS): ${response.headers.get(\"strict-transport-security\") || \"max-age=31536000\"}`);\n\n    console.log(\"\\n=== 3. TRÍCH XUẤT DỮ LIỆU JSON TỪ RESPONSE BODY ===\");\n    const data = await response.json();\n    console.log(`[+] Endpoint tài liệu API: ${data.documentation_url || 'https://docs.github.com'}`);\n    console.log(`[+] Endpoint người dùng: ${data.current_user_url || 'https://api.github.com/user'}`);\n    console.log(\"\\n>> Hoàn tất chu trình Client-Server 100%!\");\n  } catch (err) {\n    console.error(\"[-] Lỗi kết nối mạng:\", err.message);\n  }\n}\n\ninspectHttpCycle();",
          "code_breakdown": "1. fetch(\"https://api.github.com\"): Trình duyệt (Client) đóng gói một HTTP GET Request hợp lệ gửi qua giao thức bảo mật HTTPS tới Server của GitHub.\n2. response.status & response.statusText: Trả về mã trạng thái 200 OK — biểu thị Server đã tiếp nhận và xử lý yêu cầu thành công.\n3. response.headers.get(\"content-type\"): Trích xuất định dạng tài nguyên phản hồi là application/json.\n4. response.headers.get(\"server\"): Xác định loại máy chủ web đang phục vụ yêu cầu.\n5. await response.json(): Đọc luồng dữ liệu (Stream) từ Response Body và phân giải thành đối tượng JavaScript.\n(Lưu ý: Lệnh Terminal tương đương để xem Header là: curl -I https://api.github.com)"
        },
        "common_pitfalls": [
          {
            "pitfall": "Lỗi Nội dung hỗn hợp (Mixed Content Error)",
            "debug_solution": "Website gốc đã dùng HTTPS nhưng bạn lại kéo ảnh hoặc gọi API bằng đường link chứa http://. Trình duyệt sẽ khóa tài nguyên này vì nguy cơ bảo mật. Cách nhận biết: Cảnh báo đỏ ở Console báo \"Blocked loading mixed active content\". Cách sửa: Chuyển đổi toàn bộ tài nguyên API/Hình ảnh sang URL có chứa HTTPS."
          },
          {
            "pitfall": "Đợi tên miền nhận IP (DNS Propagation Delay)",
            "debug_solution": "Bạn vừa đổi IP cho tên miền trên nhà cung cấp nhưng vào trang web lại báo \"Site not found\". Đây không phải là lỗi code, mà do hệ thống DNS trên toàn cầu cần thời gian cập nhật thông tin. Cách sửa: Sử dụng trang dnschecker.org để kiểm tra trạng thái DNS, xóa cache DNS ở máy cục bộ (ipconfig /flushdns)."
          },
          {
            "pitfall": "Dùng sai HTTP Method",
            "debug_solution": "Sử dụng phương thức GET thay vì POST khi gửi Form đăng nhập. Lỗi này biến mọi mật khẩu của người dùng phơi bày rõ ràng trên thanh URL của trình duyệt. Cách sửa: Điều chỉnh method=\"POST\" ở form HTML và sửa cấu hình API phía Backend."
          }
        ],
        "tasks": [
          {
            "task_id": "web-dev_l1_1_t1",
            "difficulty": "medium",
            "description": "Mở trình duyệt Ẩn danh (Incognito), truy cập vào [https://roadmap.sh](https://roadmap.sh). Bấm phím F12 (mở DevTools), qua thẻ Network, tải lại trang web.",
            "starter_code": "# Cờ -I yêu cầu Server chỉ trả về phần Header của HTTP Response (thay vì toàn bộ file html/json)\ncurl -I https://api.github.com\n# Kết quả thực tế máy chủ trả về (Đã loại bỏ các dòng không cần thiết):\n# HTTP/2 200 OK                   <-- Mã trạng thái thành công, sử dụng giao thức HTTP bản 2.\n# server: github.com              <-- Tên định danh của máy chủ.\n# content-type: application/json  <-- Định dạng dữ liệu body trả về là JSON.\n# strict-transport-security: max-age=31536000 <-- Ràng buộc bảo mật, bắt buộc trình duyệt dùng HTTPS.",
            "validation_criteria": "Bạn phải tìm được file đầu tiên được tải trong danh sách (thường trùng tên miền roadmap.sh), bấm vào file đó. Ở mục Headers, bạn chỉ ra được \"Remote Address\" (địa chỉ IP của server), tìm được mã \"Status Code\", và khi qua thẻ \"Response\", bạn thấy toàn bộ mã HTML nguyên bản mà máy chủ trả về."
          }
        ],
        "real_world_tie_in": "<b>Chẩn đoán lỗi API nhanh chóng:</b> Khi kỹ sư Frontend phát hiện nút \"Thanh toán\" cứ xoay vòng không phản hồi, thay vì dò từng dòng mã UI, họ mở DevTools kiểm tra trạng thái HTTP. Nếu trả về mã 401 (Unauthorized), họ biết Token xác thực đã hết hạn; nếu trả về mã 500 (Internal Server Error), họ biết máy chủ Backend đang bị sập.<br><b>Triển khai sản phẩm lên tên miền gốc:</b> Sau khi code xong và đưa lên các nền tảng host như Vercel/Netlify, kỹ sư phải thao tác cấu hình bản ghi DNS (CNAME record hoặc A record) để trỏ trực tiếp tên miền công ty về IP của nền tảng host nhằm ra mắt sản phẩm cho khách hàng sử dụng.",
        "further_reading": [
