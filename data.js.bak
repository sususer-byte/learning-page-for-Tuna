        "starter_code": "#include <iostream>\n#include <vector>\nusing namespace std;\n\n// Lời giải cho: Bowling\nvoid solve() {\n    // Viết mã nguồn tại đây\n}\n\nint main() {\n    solve();\n    return 0;\n}",
