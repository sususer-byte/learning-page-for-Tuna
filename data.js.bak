    "module_exercises": {
      "web-dev-m1": {
        "milestone_id": "web-dev-m1",
        "module_index": 1,
        "title": "Bài Tập Module 1: Nền tảng Internet & Web",
        "multiple_choice": [
          {
            "q": "Trong kiến trúc Client-Server, Client đóng vai trò gì và tại sao chúng ta không gom chung tất cả logic vào Client?",
            "options": [
              "Client đóng vai trò giao diện (UI) và gửi yêu cầu; không gom logic vì bảo mật dữ liệu, tránh giả mạo logic kinh doanh và bảo vệ cơ sở dữ liệu.",
              "Client chịu trách nhiệm lưu trữ toàn bộ cơ sở dữ liệu để giảm tải cho máy chủ trung tâm.",
              "Client xử lý tính toán nặng và chứng thực bảo mật vì máy tính người dùng có cấu hình cao hơn máy chủ.",
              "Client chỉ là một bộ đệm tạm thời của mạng LAN và không có khả năng gửi yêu cầu HTTP."
            ],
            "correct": 0,
            "explanation": "Mô hình Client-Server phân tách trách nhiệm: Client quản lý trải nghiệm người dùng, Server quản lý logic nghiệp vụ và bảo vệ dữ liệu tuyệt đối."
          },
          {
            "q": "Quá trình phân giải của DNS bao gồm các bước nào trước khi tìm ra được một địa chỉ IP?",
            "options": [
              "Browser Cache -> OS Cache -> Recursive Resolver -> Root Server -> TLD Server -> Authoritative Name Server.",
              "Client gửi trực tiếp IP tới Web Server mà không qua bất kỳ máy chủ phân giải trung gian nào.",
              "Recursive Resolver quét ngẫu nhiên toàn bộ mạng Internet cho đến khi tìm thấy cổng 80 mở.",
              "Trình duyệt tự sinh địa chỉ IP ngẫu nhiên dựa trên tên miền và kiểm tra mã phản hồi."
            ],
            "correct": 0,
            "explanation": "DNS phân giải theo mô hình phân cấp từ bộ nhớ đệm cục bộ đến Root, TLD và Authoritative Name Server để lấy IP chính xác."
          },
          {
            "q": "Tính phi trạng thái (stateless) của giao thức HTTP mang ý nghĩa gì trong việc gửi các Requests?",
            "options": [
              "Mỗi request được xử lý độc lập hoàn toàn, máy chủ không tự động lưu giữ ngữ cảnh hay trạng thái giữa các request khác nhau.",
              "Máy chủ tự động ghi nhớ toàn bộ biến và thông tin đăng nhập của người dùng vào bộ nhớ RAM vĩnh viễn.",
              "Trình duyệt không được phép gửi thêm bất kỳ request nào sau khi đã nhận phản hồi đầu tiên.",
              "Mọi request đều bị mã hóa bằng khóa công khai và máy chủ không thể đọc nội dung."
            ],
            "correct": 0,
            "explanation": "HTTP Stateless giúp hệ thống dễ mở rộng theo chiều ngang (scale horizontally) vì bất kỳ máy chủ nào cũng có thể xử lý request tiếp theo."
          },
          {
            "q": "Trình duyệt dựa trên những dữ liệu nào để hình thành nên Render Tree và nó đã loại bỏ những phần tử nào?",
            "options": [
              "Kết hợp DOM và CSSOM; loại bỏ các node vô hình như <head>, <script>, <style> và các phần tử có 'display: none'.",
              "Chỉ sử dụng mã nguồn HTML thô và loại bỏ toàn bộ các tệp CSS bên ngoài.",
              "Kết hợp DOM với cookie và loại bỏ các phần tử có thuộc tính 'visibility: hidden'.",
              "Render Tree chỉ chứa các phần tử văn bản thô, toàn bộ ảnh và video bị loại bỏ."
            ],
            "correct": 0,
            "explanation": "Render Tree chỉ bao gồm các node thực sự hiển thị trên màn hình để chuẩn bị cho bước Layout và Paint."
          },
          {
            "q": "Sự khác biệt lớn nhất về hiệu suất phần cứng giữa bước Layout (Reflow) và bước Composite trong CRP là gì?",
            "options": [
              "Layout tính toán hình học trên CPU gây tốn kém tài nguyên; Composite ghép các layer trực tiếp trên GPU mang lại hiệu năng mượt mà 60 FPS.",
              "Layout thực hiện hoàn toàn trên card đồ họa GPU, trong khi Composite chạy trên ổ cứng SSD.",
              "Composite tốn tài nguyên gấp 10 lần Layout vì phải vẽ lại từng điểm ảnh.",
              "Cả hai bước đều không ảnh hưởng đến hiệu suất và luôn hoàn thành trong 0ms."
            ],
            "correct": 0,
            "explanation": "Tối ưu hóa chuyển động bằng transform và opacity cho phép chuyển việc vẽ sang GPU Composite, tránh kích hoạt CPU Layout/Paint."
          },
          {
            "q": "Bạn nên đặt thẻ <script> tải file JS lớn ở đâu trong file HTML để không chặn luồng kết xuất (Render Blocking)?",
            "options": [
              "Đặt trong <head> với thuộc tính 'defer' hoặc 'async', hoặc đặt ở cuối thẻ <body> trước thẻ đóng </body>.",
              "Đặt ở đầu thẻ <head> không có thuộc tính bổ trợ để buộc trình duyệt ưu tiên thực thi JS trước.",
              "Nhúng toàn bộ mã JS vào bên trong thuộc tính inline của thẻ <html>.",
              "Tách mã JS thành file ảnh và tải qua thẻ <img>."
            ],
            "correct": 0,
            "explanation": "Thuộc tính 'defer' giúp tải file song song và chỉ thực thi sau khi cây DOM đã được phân tích hoàn tất."
          },
          {
            "q": "'Staging Area' (Khu vực chuẩn bị) trong Git giải quyết vấn đề gì trước khi tiến hành Commit?",
            "options": [
              "Cho phép lập trình viên chọn lọc chính xác các file và dòng thay đổi cụ thể cần đưa vào commit tiếp theo thay vì gom toàn bộ.",
              "Tự động đẩy mã nguồn lên GitHub mà không cần nhập mật khẩu cá nhân.",
              "Xóa bỏ vĩnh viễn các file thừa trong thư mục làm việc để giải phóng dung lượng đĩa.",
              "Chạy các bài kiểm thử tự động trên máy chủ CI/CD của nhà cung cấp."
            ],
            "correct": 0,
            "explanation": "Staging Area (chỉ mục - index) là vùng đệm linh hoạt giúp tạo ra các commit nguyên tử (atomic commits) rõ ràng."
          }
        ],
        "essay_questions": [
          {
            "q": "Tại sao một Commit Message yêu cầu trả lời câu hỏi 'Tại sao' (Why) lại giá trị hơn câu trả lời 'Làm cái gì' (What)? Cho ví dụ minh họa.",
            "guidance": "Cần phân tích: 'What' đã được hiển thị rõ qua git diff; 'Why' giải thích ngữ cảnh nghiệp vụ, nguyên nhân gốc rễ của lỗi hoặc lý do kiến trúc đưa ra quyết định thay đổi."
          },
          {
            "q": "Phân tích rủi ro bảo mật và tổn thất khi lập trình viên vô tình đẩy file .env chứa Secret Key lên public repository và quy trình xử lý khẩn cấp.",
            "guidance": "Cần nêu: Lập tức thu hồi (revoke) và đổi key trên server; xóa lịch sử git bằng BFG hoặc git filter-repo; thêm .env vào .gitignore."
          },
          {
            "q": "Khi một trang web gặp hiện tượng FOUC (Flash of Unstyled Content), nguyên nhân cốt lõi do đâu và giải pháp xử lý kỹ thuật là gì?",
            "guidance": "Cần nêu: Do CSS tải trễ hoặc nhúng JS chèn style động; khắc phục bằng cách đặt link CSS trong <head> và inline critical CSS."
          }
        ]
      },
      "web-dev-m2": {
        "milestone_id": "web-dev-m2",
        "module_index": 2,
        "title": "Bài Tập Module 2: HTML5",
        "multiple_choice": [
          {
            "q": "Sự khác biệt cơ bản giữa chế độ Standards Mode và Quirks Mode của trình duyệt là gì? Thẻ nào chịu trách nhiệm quy định chế độ này?",
            "options": [
              "Standards Mode tuân thủ chuẩn W3C; Quirks Mode mô phỏng hành vi lỗi thời của trình duyệt cũ; khai báo <!DOCTYPE html> ở đầu tài liệu quy định điều này.",
              "Quirks Mode tăng tốc độ tải trang lên gấp đôi bằng cách bỏ qua toàn bộ CSS; quy định bởi thẻ <meta charset='utf-8'>.",
              "Standards Mode chỉ hỗ trợ JavaScript, Quirks Mode chỉ hỗ trợ hình ảnh; quy định bởi thẻ <html lang='vi'>.",
              "Cả hai chế độ giống nhau và chỉ khác ở việc hiển thị font chữ serif hay sans-serif."
            ],
            "correct": 0,
            "explanation": "Khai báo <!DOCTYPE html> đảm bảo trình duyệt kích hoạt Standards Mode hiện đại và hiển thị layout chuẩn xác theo W3C."
          },
          {
            "q": "Tại sao một trang web có thể đạt điểm cao về mặt thị giác nhưng lại hoàn toàn vô dụng trên Accessibility (A11y)?",
            "options": [
              "Vì sử dụng thẻ không có ngữ nghĩa (như <div>, <span>) để làm nút bấm, thiếu ARIA attributes và không thể điều hướng bằng bàn phím cho Screen Reader.",
              "Vì trang web dùng quá nhiều hình ảnh chất lượng cao khiến màn hình người mù không tải kịp.",
